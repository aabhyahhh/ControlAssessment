# --- Environment ---
# "development" allows the insecure default JWT_SECRET with a warning; any
# other value (e.g. "production") refuses to start unless JWT_SECRET below
# is set to something other than the default.
ENVIRONMENT=development

# --- Postgres ---
# Needs a Postgres server already running and reachable at this host/port —
# starting Postgres itself is still a manual, OS-specific step. Everything
# past that is automatic: the backend creates POSTGRES_DB on startup if it
# doesn't exist yet, then applies migrations (see README.md).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=control_assessment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# --- Azure OpenAI (independent config — not shared with ControlIris) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5.2-chat
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Storage ---
STORAGE_ROOT=../storage

# --- Server ---
CORS_ORIGINS=http://localhost:8090

# --- SMTP (justification emails) ---
# Used by Step 2's "send justification email" feature. Leave SMTP_HOST/
# SMTP_FROM_ADDRESS blank to leave the feature disabled (send requests fail
# with a clear 4xx rather than crash).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
