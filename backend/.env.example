# --- Environment ---
# "development" allows the insecure default JWT_SECRET with a warning; any
# other value (e.g. "production") refuses to start unless JWT_SECRET below
# is set to something other than the default.
ENVIRONMENT=development

# --- Postgres ---
# Uses a dedicated local Postgres 18 instance on port 5433 (not the system
# default 5432, which may be occupied by another Postgres install/service).
# Start it with: pg_ctl -D /opt/homebrew/var/postgresql@18 -l /tmp/ca_pg18.log -o "-p 5433" start
DATABASE_URL=postgresql://user:password@localhost:5433/controlassessment

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# --- Azure OpenAI (independent config — not shared with ControlIris) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-5.2-chat
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Storage ---
STORAGE_ROOT=../storage

# --- Server ---
CORS_ORIGINS=http://localhost:8090
