# OS / Editor
.DS_Store
.idea/
.vscode/

# Node / frontend
frontend/node_modules/
frontend/dist/

# Python / backend
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.env

# Local storage (uploaded files, artifacts) — repo-root only; a leading
# slash anchors this so it doesn't also match backend/app/storage/, which is
# the real Python package that manages this directory, not runtime data.
/storage/

# Logs
*.log

# Secrets / local env (keep .env.example only)
.env
.env.*
!.env.example
*.bak
